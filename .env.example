# Copie para .env e informe a senha real do MySQL local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=PREENCHA_COM_A_SENHA_LOCAL
DB_NAME=escola_hello_kitty
